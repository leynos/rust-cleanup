    },
    {
      "name": "equality-does-not-recover",
      "exit_percent": 75,
      "usage_readings": [
        82,
        75
      ],
      "expected_next_action": "continue-if-safe-work-remains"
    },
    {
      "name": "partial-failure-reread",
      "exit_percent": 75,
      "usage_readings": [
        82,
        74
      ],
